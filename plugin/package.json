{
  "name": "dsh-tripo-support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tripo, DashScope/qianwenai and Tencent Hunyuan3D async 3D providers for DeepSeek Harness.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "assets/model-viewer.min.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "assets/LICENSE-model-viewer",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
