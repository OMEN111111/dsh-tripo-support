{
  "name": "dsh-tripo-support",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "Tripo, Meshy, Hyper3D, DashScope/qianwenai and Tencent Hunyuan3D async 3D providers for DeepSeek Harness, with in-chat 3D preview and a 3D workshop.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "assets/model-viewer.min.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "assets/LICENSE-model-viewer",
    "THIRD_PARTY_NOTICES.md",
    "assets/viewer3d.js",
    "assets/LICENSE-three"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OMEN111111/dsh-tripo-support.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/OMEN111111/dsh-tripo-support",
  "bugs": {
    "url": "https://github.com/OMEN111111/dsh-tripo-support/issues"
  },
  "license": "MIT",
  "author": "OMEN111111",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  }
}
