{
  "name": "dsh-tripo-support",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Tripo, Meshy, Hyper3D, DashScope/qianwenai and Tencent Hunyuan3D async 3D providers for DeepSeek Harness, with in-chat 3D preview.",
  "license": "MIT",
  "author": "OMEN111111",
  "repository": {
    "type": "git",
    "url": "https://github.com/OMEN111111/dsh-tripo-support.git"
  },
  "homepage": "https://github.com/OMEN111111/dsh-tripo-support",
  "bugs": {
    "url": "https://github.com/OMEN111111/dsh-tripo-support/issues"
  },
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./locale/*.json": "./plugin/locale/*.json",
    "./icon": "./plugin/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/**/*",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  }
}
